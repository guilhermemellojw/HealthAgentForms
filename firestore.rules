rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Verifica se está logado
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Verifica se é Admin (E-mail específico ou Role no Firestore)
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'gmellobkp@gmail.com' || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN')
      );
    }
    
    // Verifica se é Staff (Admin ou Supervisor autorizado)
    function isStaff() {
      return isSignedIn() && (
        isAdmin() || (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAuthorized == true && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'SUPERVISOR'
        )
      );
    }

    // 1. Coleção de Usuários
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin() || (request.auth.uid == userId && 
        !request.resource.data.role && 
        !request.resource.data.isAuthorized);
    }
    
    // 2. Coleção de Agentes e subcoleções
    match /agents/{agentId} {
      allow read, write: if (isSignedIn() && request.auth.uid == agentId) || isStaff();
      
      // PERMISSÃO COLABORATIVA CIRÚRGICA:
      // Qualquer agente logado pode ler imóveis de outros agentes para montar o RG unificado.
      // Modificações nos imóveis continuam exclusivas ao dono (agentId) ou à equipe Staff.
      match /houses/{houseId} {
        allow read: if isSignedIn();
        allow write: if (isSignedIn() && request.auth.uid == agentId) || isStaff();
      }
      
      match /{subcollection=**} {
        allow read, write: if (isSignedIn() && request.auth.uid == agentId) || isStaff();
      }
    }
    
    // 3. Metadata (agent_info, locations, settings) — leitura aberta para logados, escrita só Admin
    match /metadata/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    
    // 4. Acesso e solicitações de acesso (Merge unificado)
    match /access_requests/{requestId} {
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.uid;
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.uid);
      allow read, delete: if isAdmin();
    }
    
    // 5. Admins (espelho do role no users/ usado pelos repositórios)
    match /admins/{uid} {
      allow read, write: if isAdmin();
    }
    
    // 6. Permissão de Grupo de Coleções (Collection Group)
    // Permite apenas que a equipe Staff execute a busca unificada por bairros/quarteirões.
    match /{path=**}/houses/{houseId} {
      allow read: if isStaff();
    }

    // 7. Catch-all de segurança para Admin
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
